model User {
  id                             Int                       @id @default(autoincrement())
  companyId                      Int?                      @map("company_id")
  userTypeId                     Int?                      @map("user_type_id")
  name                           String                    @db.VarChar(100)
  lastName                       String                    @map("last_name") @db.VarChar(100)
  avatar                         String?                   @db.VarChar(255)
  email                          String                    @unique @db.VarChar(255)
  emailVerifiedAt                DateTime?                 @map("email_verified_at") @db.Timestamp(0)
  password                       String                    @db.VarChar(60)
  passwordExpiry                 DateTime?                 @map("password_expiry") @db.Timestamp(0)
  rememberToken                  String?                   @map("remember_token") @db.VarChar(100)
  phoneCountryCode               String?                   @map("phone_country_code") @db.VarChar(4)
  phone                          String?                   @db.VarChar(15)
  celPhoneCountryCode            String?                   @map("cel_phone_country_code") @db.VarChar(4)
  celPhone                       String?                   @map("cel_phone") @db.VarChar(15)
  infoCelPhone                   String?                   @map("info_cel_phone") @db.VarChar(255)
  infoCelPhoneCountryCode        String?                   @map("info_cel_phone_country_code") @db.VarChar(10)
  twoFactorAuthenticationEnabled Boolean                   @default(false) @map("two_factor_authentication_enabled")
  twoFactorAuthSuggestionEnabled Boolean                   @default(true) @map("two_factor_auth_suggestion_enabled")
  pendingApproval                Boolean                   @default(false) @map("pending_approval")
  createdAt                      DateTime?                 @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                      DateTime?                 @updatedAt @map("updated_at") @db.Timestamp(0)
  roleId                         Int?                      @map("role_id")
  verificationToken              String?                   @map("verification_token") @db.VarChar(255)
  language                       String                    @default("es") @db.VarChar(5)
  accountStatus                  UserAccountStatus         @default(active) @map("account_status")
  deactivationReason             String?                   @map("deactivation_reason") @db.Text
  deactivatedAt                  DateTime?                 @map("deactivated_at") @db.Timestamp(0)
  biddingUserStatuses            BiddingUserStatus[]
  createdBiddings                Bidding[]                 @relation("biddings_created_byTousers")
  updatedBiddings                Bidding[]                 @relation("biddings_updated_byTousers")
  comments                       Comment[]
  conversationUsers              ConversationUser[]
  receivedFriendRequests         FriendRequest[]           @relation("friend_requests_receiver_idTousers")
  sentFriendRequests             FriendRequest[]           @relation("friend_requests_sender_idTousers")
  friendshipsAsFriend            Friendship[]              @relation("friendships_friend_idTousers")
  friendshipsAsUser              Friendship[]              @relation("friendships_user_idTousers")
  messages                       Message[]
  sentNotifications              Notification[]            @relation("notifications_sender_idTousers")
  notifications                  Notification[]            @relation("notifications_user_idTousers")
  payments                       Payment[]
  postLikes                      PostLike[]
  posts                          Post[]
  createdProductCatalogs         ProductCatalog[]          @relation("product_catalogs_created_byTousers")
  updatedProductCatalogs         ProductCatalog[]          @relation("product_catalogs_updated_byTousers")
  profileViewsReceived           ProfileView[]             @relation("profile_views_viewed_idTousers")
  profileViewsMade               ProfileView[]             @relation("profile_views_viewer_idTousers")
  quotes                         Quote[]
  ratings                        Rating[]
  sellerGeographicScopes         SellerGeographicScope[]
  subscriptions                  Subscription[]
  userAddresses                  UserAddress[]
  userCategories                 UserCategory[]
  userMessageCategories          UserMessageCategory[]
  userNotificationChannels       UserNotificationChannel[]
  company                        Company?                  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role                           Role?                     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userType                       UserType?                 @relation(fields: [userTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@index([roleId])
  @@index([userTypeId])
  @@map("users")
}

