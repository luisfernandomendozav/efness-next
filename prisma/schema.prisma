model Quote {
  id                 Int            @id @default(autoincrement())
  biddingId          Int            @map("bidding_id")
  quoteNumber        String         @map("quote_number") @db.VarChar(255)
  userId             Int            @map("user_id")
  companyId          Int            @map("company_id")
  subtotal           Decimal        @db.Decimal(15, 2)
  totalTaxes         Decimal        @map("total_taxes") @db.Decimal(15, 2)
  total              Decimal        @db.Decimal(15, 2)
  currency           String         @db.VarChar(5)
  paymentStatus      String         @default("pending") @map("payment_status") @db.VarChar(255)
  deliveryStatus     String         @default("pending") @map("delivery_status") @db.VarChar(255)
  costShipping       Decimal?       @map("cost_shipping") @db.Decimal(15, 2)
  status             String         @default("active") @db.VarChar(255)
  deliveryDate       DateTime?      @map("delivery_date") @db.Date
  deliveryType       String?        @map("delivery_type") @db.VarChar(255)
  shippingAddress    String?        @map("shipping_address") @db.Text
  createdAt          DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime?      @updatedAt @map("updated_at") @db.Timestamp(0)
