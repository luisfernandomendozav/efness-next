generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BiddingCompanyStatus {
  id        Int       @id @default(autoincrement())
  biddingId Int       @map("bidding_id")
  companyId Int       @map("company_id")
  status    String    @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  bidding   Bidding   @relation(fields: [biddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([biddingId])
  @@index([companyId])
  @@map("bidding_company_statuses")
}

model BiddingProduct {
  id                  Int                 @id @default(autoincrement())
  biddingId           Int                 @map("bidding_id")
  orderId             Int?                @map("order_id")
  productCatalogId    Int                 @map("product_catalog_id")
  name                String              @db.VarChar(255)
  quantity            Int
  comments            String?             @db.VarChar(1000)
  createdAt           DateTime?           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime?           @updatedAt @map("updated_at") @db.Timestamp(0)
  bidding             Bidding             @relation(fields: [biddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order               Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productCatalog      ProductCatalog      @relation(fields: [productCatalogId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  biddingProductTaxes BiddingProductTax[]
  quoteProducts       QuoteProduct[]

  @@index([biddingId])
  @@index([orderId])
  @@index([productCatalogId])
  @@map("bidding_products")
}

model BiddingProductTax {
  id               Int            @id @default(autoincrement())
  biddingProductId Int            @map("bidding_product_id")
  taxId            Int            @map("tax_id")
  taxRate          Decimal        @map("tax_rate") @db.Decimal(8, 2)
  createdAt        DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime?      @updatedAt @map("updated_at") @db.Timestamp(0)
  biddingProduct   BiddingProduct @relation(fields: [biddingProductId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tax              Tax            @relation(fields: [taxId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([biddingProductId, taxId])
  @@index([taxId])
  @@map("bidding_products_taxes")
}

model BiddingUserStatus {
  id        Int       @id @default(autoincrement())
  biddingId Int       @map("bidding_id")
  userId    Int       @map("user_id")
  status    String    @default("open") @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  bidding   Bidding   @relation(fields: [biddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([biddingId])
  @@index([userId])
  @@map("bidding_user_statuses")
}

model Bidding {
  id                     Int                    @id @default(autoincrement())
  biddingNumber          String                 @map("bidding_number") @db.VarChar(255)
  createdBy              Int                    @map("created_by")
  updatedBy              Int?                   @map("updated_by")
  description            String?                @db.VarChar(255)
  deadline               DateTime?              @db.Timestamp(0)
  deliveryDate           DateTime?              @map("delivery_date") @db.Timestamp(0)
  paymentStatus          String                 @default("pending") @map("payment_status") @db.VarChar(50)
  deliveryStatus         String                 @default("pending") @map("delivery_status") @db.VarChar(50)
  addressId              Int?                   @map("address_id")
  currency               String                 @db.VarChar(10)
  deliveryType           String                 @map("delivery_type") @db.VarChar(50)
  costShipping           Decimal                @map("cost_shipping") @db.Decimal(10, 2)
  subtotal               Decimal                @db.Decimal(15, 2)
  totalTaxes             Decimal                @map("total_taxes") @db.Decimal(15, 2)
  total                  Decimal                @db.Decimal(15, 2)
  status                 String                 @db.VarChar(50)
  notifiedToday          Boolean                @default(false) @map("notified_today")
  confirmed              Boolean                @default(false)
  rated                  Boolean                @default(false)
  categoryId             Int?                   @map("category_id")
  attachments            String?                @db.VarChar(255)
  notes                  String?                @db.Text
  createdAt              DateTime?              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt              DateTime?              @updatedAt @map("updated_at") @db.Timestamp(0)
  biddingCompanyStatuses BiddingCompanyStatus[]
  biddingProducts        BiddingProduct[]
  biddingUserStatuses    BiddingUserStatus[]
  address                UserAddress?           @relation(fields: [addressId], references: [id], onUpdate: NoAction)
  category               Category?              @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  creator                User                   @relation("biddings_created_byTousers", fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updater                User?                  @relation("biddings_updated_byTousers", fields: [updatedBy], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders                 Order[]
  quotes                 Quote[]
  ratings                Rating[]

  @@index([addressId])
  @@index([categoryId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("biddings")
}

model Category {
  id             Int            @id @default(autoincrement())
  name           String         @db.VarChar(255)
  description    String?        @db.Text
  productTypeId  Int?           @map("product_type_id")
  createdAt      DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime?      @updatedAt @map("updated_at") @db.Timestamp(0)
  biddings       Bidding[]
  productType    ProductType?   @relation(fields: [productTypeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userCategories UserCategory[]

  @@index([productTypeId])
  @@map("categories")
}

model Comment {
  id        Int       @id @default(autoincrement())
  postId    Int       @map("post_id")
  userId    Int       @map("user_id")
  content   String    @db.Text
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([postId])
  @@index([userId])
  @@map("comments")
}

model Company {
  id                     Int                    @id @default(autoincrement())
  name                   String                 @db.VarChar(255)
  webSite                String?                @map("web_site") @db.VarChar(255)
  rfcTaxId               String                 @unique @map("rfc_tax_id") @db.VarChar(255)
  country                String?                @db.VarChar(255)
  state                  String?                @db.VarChar(255)
  city                   String?                @db.VarChar(255)
  address                String?                @db.VarChar(255)
  zipCode                String?                @map("zip_code") @db.VarChar(255)
  photo                  String?                @db.VarChar(255)
  logo                   String?                @db.VarChar(255)
  createdAt              DateTime?              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt              DateTime?              @updatedAt @map("updated_at") @db.Timestamp(0)
  rating                 Float                  @default(0.00)
  ratingCount            Int                    @default(0) @map("rating_count")
  biddingCompanyStatuses BiddingCompanyStatus[]
  companyFolioNumbers    CompanyFolioNumber[]
  orders                 Order[]
  posts                  Post[]
  productCatalogs        ProductCatalog[]
  quotes                 Quote[]
  ratings                Rating[]
  users                  User[]

  @@map("companies")
}

model CompanyFolioNumber {
  id         Int       @id @default(autoincrement())
  companyId  Int       @map("company_id")
  year       Int
  entityType String    @map("entity_type") @db.VarChar(255)
  lastNumber Int       @default(0) @map("last_number")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([companyId, year, entityType])
  @@map("company_folio_numbers")
}

model ConversationUser {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  userId         Int          @map("user_id")
  rol            String?      @db.VarChar(255)
  incomeAt       DateTime?    @map("income_at") @db.Timestamp(0)
  outcomeAt      DateTime?    @map("outcome_at") @db.Timestamp(0)
  readAt         DateTime?    @map("read_at") @db.Timestamp(0)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime?    @updatedAt @map("updated_at") @db.Timestamp(0)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversationId])
  @@index([userId])
  @@map("conversation_users")
}

model Conversation {
  id                Int                @id @default(autoincrement())
  type              String             @default("direct") @db.VarChar(255)
  name              String?            @db.VarChar(255)
  description       String?            @db.Text
  image             String?            @db.VarChar(255)
  lastActivityAt    DateTime?          @map("last_activity_at") @db.Timestamp(0)
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime?          @updatedAt @map("updated_at") @db.Timestamp(0)
  isActive          Boolean            @default(true) @map("is_active")
  conversationUsers ConversationUser[]
  messages          Message[]

  @@map("conversations")
}

model Country {
  id                     Int                     @id @default(autoincrement())
  name                   String                  @db.VarChar(100)
  isoCode                String                  @unique @map("iso_code") @db.VarChar(3)
  createdAt              DateTime?               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt              DateTime?               @updatedAt @map("updated_at") @db.Timestamp(0)
  boundaryCoordinates    Json?                   @map("boundary_coordinates")
  sellerGeographicScopes SellerGeographicScope[]
  states                 State[]
  userAddresses          UserAddress[]

  @@map("countries")
}

model ExchangeRate {
  id             Int       @id @default(autoincrement())
  sourceCurrency String    @map("source_currency") @db.VarChar(255)
  targetCurrency String    @map("target_currency") @db.VarChar(255)
  rate           Decimal   @db.Decimal(15, 6)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("exchange_rates")
}

model Feature {
  id           Int           @id @default(autoincrement())
  title        String        @db.VarChar(255)
  isVisible    Boolean       @default(true) @map("is_visible")
  createdAt    DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime?     @updatedAt @map("updated_at") @db.Timestamp(0)
  planFeatures PlanFeature[]

  @@map("features")
}

model FriendRequest {
  id         Int                 @id @default(autoincrement())
  senderId   Int                 @map("sender_id")
  receiverId Int                 @map("receiver_id")
  status     FriendRequestStatus @default(pending)
  createdAt  DateTime?           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime?           @updatedAt @map("updated_at") @db.Timestamp(0)
  receiver   User                @relation("friend_requests_receiver_idTousers", fields: [receiverId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender     User                @relation("friend_requests_sender_idTousers", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([senderId, receiverId])
  @@index([receiverId])
  @@map("friend_requests")
}

model Friendship {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  friendId  Int       @map("friend_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  friend    User      @relation("friendships_friend_idTousers", fields: [friendId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation("friendships_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}

model MessageCategory {
  id                    Int                   @id @default(autoincrement())
  name                  String                @unique @db.VarChar(255)
  description           String?               @db.VarChar(255)
  createdAt             DateTime?             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime?             @updatedAt @map("updated_at") @db.Timestamp(0)
  notifications         Notification[]
  userMessageCategories UserMessageCategory[]

  @@map("message_categories")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  senderId       Int?         @map("sender_id")
  content        String       @db.Text
  type           String       @default("text") @db.VarChar(255)
  sentAt         DateTime     @default(now()) @map("sent_at") @db.Timestamp(0)
  deliveredAt    DateTime?    @map("delivered_at") @db.Timestamp(0)
  readAt         DateTime?    @map("read_at") @db.Timestamp(0)
  deleted        Boolean      @default(false)
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime?    @updatedAt @map("updated_at") @db.Timestamp(0)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender         User?        @relation(fields: [senderId], references: [id], onUpdate: NoAction)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model NotificationChannel {
  id                       Int                       @id @default(autoincrement())
  name                     String                    @unique @db.VarChar(255)
  description              String?                   @db.VarChar(255)
  active                   Boolean                   @default(true)
  createdAt                DateTime?                 @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                DateTime?                 @updatedAt @map("updated_at") @db.Timestamp(0)
  notifications            Notification[]
  userNotificationChannels UserNotificationChannel[]

  @@map("notification_channels")
}

model Notification {
  id                      Int                 @id @default(autoincrement())
  userId                  Int                 @map("user_id")
  userName                String?             @map("user_name") @db.VarChar(100)
  userLastName            String?             @map("user_last_name") @db.VarChar(100)
  userEmail               String?             @map("user_email") @db.VarChar(100)
  userCelPhoneCountryCode String?             @map("user_cel_phone_country_code") @db.VarChar(4)
  userCelPhone            String?             @map("user_cel_phone") @db.VarChar(20)
  tokenDevice             String?             @map("token_device") @db.VarChar(255)
  messageCategoryId       Int                 @map("message_category_id")
  notificationChannelId   Int                 @map("notification_channel_id")
  message                 String              @db.Text
  data                    Json?
  type                    String?             @db.VarChar(50)
  sendStatus              String?             @default("pending") @map("send_status") @db.VarChar(50)
  websocketSent           Boolean             @default(false) @map("websocket_sent")
  readStatus              String?             @map("read_status") @db.VarChar(255)
  readAt                  DateTime?           @map("read_at") @db.Timestamp(0)
  createdAt               DateTime?           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt               DateTime?           @updatedAt @map("updated_at") @db.Timestamp(0)
  senderId                Int?                @map("sender_id")
  messageCategory         MessageCategory     @relation(fields: [messageCategoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notificationChannel     NotificationChannel @relation(fields: [notificationChannelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender                  User?               @relation("notifications_sender_idTousers", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                    User                @relation("notifications_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([messageCategoryId])
  @@index([notificationChannelId])
  @@index([senderId])
  @@index([type])
  @@index([userId])
  @@map("notifications")
}

model OrderProduct {
  id                Int               @id @default(autoincrement())
  orderId           Int               @map("order_id")
  productCatalogId  Int               @map("product_catalog_id")
  quantity          Int
  price             Decimal           @db.Decimal(10, 2)
  total             Decimal           @db.Decimal(10, 2)
  createdAt         DateTime?         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime?         @updatedAt @map("updated_at") @db.Timestamp(0)
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productCatalog    ProductCatalog    @relation(fields: [productCatalogId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orderProductTaxes OrderProductTax[]

  @@index([orderId])
  @@index([productCatalogId])
  @@map("order_products")
}

model OrderProductTax {
  id             Int          @id @default(autoincrement())
  orderProductId Int          @map("order_product_id")
  taxId          Int          @map("tax_id")
  taxRate        Decimal      @map("tax_rate") @db.Decimal(5, 2)
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime?    @updatedAt @map("updated_at") @db.Timestamp(0)
  orderProduct   OrderProduct @relation(fields: [orderProductId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tax            Tax          @relation(fields: [taxId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderProductId])
  @@index([taxId])
  @@map("order_products_taxes")
}

model Order {
  id              Int              @id @default(autoincrement())
  orderNumber     String           @map("order_number") @db.VarChar(255)
  companyId       Int              @map("company_id")
  biddingId       Int              @map("bidding_id")
  status          String           @default("Pending") @db.VarChar(255)
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime?        @updatedAt @map("updated_at") @db.Timestamp(0)
  biddingProducts BiddingProduct[]
  orderProducts   OrderProduct[]
  bidding         Bidding          @relation(fields: [biddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([biddingId])
  @@index([companyId])
  @@map("orders")
}

model PasswordResetToken {
  email     String    @id @db.VarChar(255)
  token     String    @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("password_reset_tokens")
}

model PaymentStatus {
  id        Int       @id @default(autoincrement())
  status    String    @unique @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  payments  Payment[]

  @@map("payment_statuses")
}

model PaymentTerm {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  quotes      Quote[]

  @@map("payment_terms")
}

model Payment {
  id              Int           @id @default(autoincrement())
  userId          Int           @map("user_id")
  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   String        @map("payment_method") @db.VarChar(255)
  paymentStatusId Int           @map("payment_status_id")
  paymentId       String?       @map("payment_id") @db.VarChar(255)
  createdAt       DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime?     @updatedAt @map("updated_at") @db.Timestamp(0)
  paymentStatus   PaymentStatus @relation(fields: [paymentStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([paymentStatusId])
  @@index([userId])
  @@map("payments")
}

model PlanFeature {
  id        Int       @id @default(autoincrement())
  planId    Int       @map("plan_id")
  featureId Int       @map("feature_id")
  supported Boolean
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  feature   Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([featureId])
  @@index([planId])
  @@map("plan_features")
}

model Plan {
  id                Int            @id @default(autoincrement())
  title             String         @db.VarChar(255)
  subtitle          String?        @db.VarChar(255)
  description       String?        @db.Text
  priceBuyerMonth   Decimal?       @map("price_buyer_month") @db.Decimal(10, 2)
  priceBuyerAnnual  Decimal?       @map("price_buyer_annual") @db.Decimal(10, 2)
  priceSellerMonth  Decimal?       @map("price_seller_month") @db.Decimal(10, 2)
  priceSellerAnnual Decimal?       @map("price_seller_annual") @db.Decimal(10, 2)
  createdAt         DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime?      @updatedAt @map("updated_at") @db.Timestamp(0)
  default           Boolean        @default(false)
  custom            Boolean        @default(false)
  planFeatures      PlanFeature[]
  subscriptions     Subscription[]

  @@map("plans")
}

model PostLike {
  id        Int       @id @default(autoincrement())
  postId    Int       @map("post_id")
  userId    Int       @map("user_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model Post {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  companyId      Int            @map("company_id")
  content        String         @db.Text
  image          String?        @db.VarChar(255)
  visibility     PostVisibility @default(public)
  originalPostId Int?           @map("original_post_id")
  likesCount     Int            @default(0) @map("likes_count")
  commentsCount  Int            @default(0) @map("comments_count")
  sharesCount    Int            @default(0) @map("shares_count")
  createdAt      DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime?      @updatedAt @map("updated_at") @db.Timestamp(0)
  comments       Comment[]
  postLikes      PostLike[]
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  originalPost   Post?          @relation("postsToposts", fields: [originalPostId], references: [id], onUpdate: NoAction)
  reposts        Post[]         @relation("postsToposts")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([companyId])
  @@index([originalPostId])
  @@index([userId])
  @@map("posts")
}

model ProductCatalog {
  id                  Int                 @id @default(autoincrement())
  companyId           Int                 @map("company_id")
  productTypeId       Int                 @map("product_type_id")
  createdBy           Int                 @map("created_by")
  updatedBy           Int?                @map("updated_by")
  name                String              @db.VarChar(5000)
  brand               String?             @db.VarChar(255)
  internalCode        String              @map("internal_code") @db.VarChar(255)
  externalCode        String?             @map("external_code") @db.VarChar(255)
  satKey              String?             @map("sat_key") @db.VarChar(255)
  description         String?             @db.Text
  keywords            Json?
  technicalSheet      String?             @map("technical_sheet") @db.VarChar(255)
  image               String?             @db.VarChar(255)
  price               Decimal             @db.Decimal(10, 2)
  stockQuantity       BigInt              @default(0) @map("stock_quantity")
  unitId              Int                 @map("unit_id")
  createdAt           DateTime?           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime?           @updatedAt @map("updated_at") @db.Timestamp(0)
  biddingProducts     BiddingProduct[]
  orderProducts       OrderProduct[]
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator             User                @relation("product_catalogs_created_byTousers", fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productType         ProductType         @relation(fields: [productTypeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit                Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updater             User?               @relation("product_catalogs_updated_byTousers", fields: [updatedBy], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productCatalogTaxes ProductCatalogTax[]
  quoteProducts       QuoteProduct[]

  @@unique([companyId, externalCode])
  @@unique([companyId, internalCode])
  @@index([createdBy])
  @@index([productTypeId])
  @@index([unitId])
  @@index([updatedBy])
  @@map("product_catalogs")
}

model ProductCatalogTax {
