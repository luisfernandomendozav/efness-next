# Copia este archivo a .env y completa los valores. Detalle de cada
# integración en API_CHANGE_LOG.md.

# Neon Postgres — URL directa (sin pooler) para migraciones
DATABASE_URL=""
DATABASE_URL_POOLED=""

# Auth.js
AUTH_SECRET=""
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3000"

# URL pública de la app (links de correos, Auth.js)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Twilio (2FA por SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# SendGrid (correo transaccional y notificaciones: verificación de cuenta,
# aviso de nueva requisición a proveedores). Igual que el backend legacy
# (config/services.php). Sin API key, los correos solo se registran en
# consola (modo dev).
SENDGRID_API_KEY=""
SENDGRID_EMAIL_FROM=""
SENDGRID_EMAIL_FROM_NAME="Efness Company"

# Vercel Blob (avatares, logos, imágenes de producto, archivos del chat)
BLOB_READ_WRITE_TOKEN=""

# Mercado Pago
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=""
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY_SANDBOX=""
NEXT_PUBLIC_MERCADO_PAGO_SANDBOX="false"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_ID=""
